<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pojobook</groupId>
        <artifactId>pojobook-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>pojobook-benchmark</artifactId>
    <packaging>jar</packaging>

    <properties>
        <jackson.version>2.19.2</jackson.version>
        <lombok.version>1.18.42</lombok.version>
        <commons-lang3.version>3.19.0</commons-lang3.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <jrecord.version>0.93.3</jrecord.version>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.sf</groupId>
            <artifactId>jrecord</artifactId>
            <version>${jrecord.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/JRecord.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.sf</groupId>
            <artifactId>jrecord-cb2xml</artifactId>
            <version>${jrecord.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/cb2xml.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.pojobook</groupId>
            <artifactId>pojobook-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>

        <!-- JMH Benchmarking -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.pojobook</groupId>
                <artifactId>pojobook-maven-plugin</artifactId>
                <executions>
                    <!-- Generate POJOs from all copybook files -->
                    <execution>
                        <id>generate-embedded</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <copybookFile>${project.basedir}/src/main/resources/copybook/*.cbl</copybookFile>
                            <packageName>org.pojobook.samples.embedded</packageName>
                            <generatorType>embedded</generatorType>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-annotation</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <copybookFile>${project.basedir}/src/main/resources/copybook/*.cbl</copybookFile>
                            <packageName>org.pojobook.samples.annotation</packageName>
                            <generatorType>annotation</generatorType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Exec plugin for running benchmarks -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>

            <!-- Dependency plugin for classpath management -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </build>
</project>