<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.c4rth</groupId>
        <artifactId>pojobook-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>private-samples</artifactId>
    <packaging>jar</packaging>

    <properties>
        <jackson.version>2.19.2</jackson.version>
        <lombok.version>1.18.42</lombok.version>
        <commons-lang3.version>3.19.0</commons-lang3.version>
        <mapstruct.version>1.6.3</mapstruct.version>
    </properties>

    <dependencies>
        <!-- pojobook-serializer - only for CharacterEncoding enum -->
        <!-- Embedded POJOs don't use CobolSerializer/CobolDeserializer -->
        <dependency>
            <groupId>org.c4rth</groupId>
            <artifactId>pojobook-serializer</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- PojoBook Maven Plugin - Generate POJOs with EMBEDDED serialization -->
            <plugin>
                <groupId>org.c4rth</groupId>
                <artifactId>pojobook-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <!-- Generate POJOs from all copybook files -->
                    <execution>
                        <id>generate-embedded</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <copybookFile>${project.basedir}/src/test/resources/copybook/*.cbl</copybookFile>
                            <packageName>org.c4rth.pojobook.embedded</packageName>
                            <generatorType>embedded</generatorType>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-annotation</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <copybookFile>${project.basedir}/src/test/resources/copybook/*.cbl</copybookFile>
                            <packageName>org.c4rth.pojobook.annotation</packageName>
                            <generatorType>annotation</generatorType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>

